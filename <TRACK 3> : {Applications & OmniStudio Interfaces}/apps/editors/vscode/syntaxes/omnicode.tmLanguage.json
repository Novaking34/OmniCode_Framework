{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OmniCode",
  "scopeName": "source.omnicode",
  "patterns": [
    { "include": "#comments" },
    { "include": "#boundary_casts" },
    { "include": "#primes" },
    { "include": "#affixed_identifiers" },
    { "include": "#asides" },
    { "include": "#strings" },
    { "include": "#ternary_literals" },
    { "include": "#vectors" },
    { "include": "#being_relations" },
    { "include": "#connectives" },
    { "include": "#boundaries" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#registers" },
    { "include": "#categories" },
    { "include": "#instances" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.omnicode",
          "match": "#.*$"
        }
      ]
    },
    "boundary_casts": {
      "patterns": [
        {
          "name": "keyword.operator.boundary_cast.omnicode",
          "match": "\\[\\+\\]|\\[\\-\\]|<\\+>|<\\->|\\{\\+\\}|\\{\\-\\}"
        }
      ]
    },
    "primes": {
      "patterns": [
        {
          "name": "variable.other.prime.omnicode",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*`+"
        }
      ]
    },
    "affixed_identifiers": {
      "patterns": [
        {
          "name": "variable.other.affixed.abstract.omnicode",
          "match": "\\+[a-zA-Z_][a-zA-Z0-9_]*|[a-zA-Z_][a-zA-Z0-9_]*\\+"
        },
        {
          "name": "variable.other.affixed.concrete.omnicode",
          "match": "\\-[a-zA-Z_][a-zA-Z0-9_]*|[a-zA-Z_][a-zA-Z0-9_]*\\-"
        }
      ]
    },
    "asides": {
      "patterns": [
        {
          "name": "meta.aside.omnicode",
          "begin": "\\(",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.aside.begin.omnicode" }
          },
          "end": "\\)",
          "endCaptures": {
            "0": { "name": "punctuation.definition.aside.end.omnicode" }
          },
          "patterns": [
            {
              "name": "string.unquoted.aside.intent.omnicode",
              "match": "[^()]+"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.omnicode",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.omnicode",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.omnicode",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {
              "name": "constant.character.escape.omnicode",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "ternary_literals": {
      "patterns": [
        {
          "name": "constant.language.ternary.proceed.omnicode",
          "match": "\\+1\\b|\\b(YES|PROCEED)\\b"
        },
        {
          "name": "constant.language.ternary.rollback.omnicode",
          "match": "-1\\b|\\b(NO|ROLLBACK)\\b"
        },
        {
          "name": "constant.language.ternary.await.omnicode",
          "match": "\\b0\\b|\\b(OK|AWAIT)\\b"
        },
        {
          "name": "constant.language.ternary.halt.omnicode",
          "match": "\\b(NULL|VOID|HALT)\\b"
        }
      ]
    },
    "vectors": {
      "patterns": [
        {
          "name": "keyword.operator.vector.scale.diagonal.major.omnicode",
          "match": "/-\\^"
        },
        {
          "name": "keyword.operator.vector.scale.diagonal.minor.omnicode",
          "match": "\\\\-v"
        },
        {
          "name": "keyword.operator.vector.scale.diagonal.great.omnicode",
          "match": "\\\\-\\^"
        },
        {
          "name": "keyword.operator.vector.scale.diagonal.small.omnicode",
          "match": "/-v"
        },
        {
          "name": "keyword.operator.vector.quadrant.omnicode",
          "match": "/\\^|\\\\v|\\^\\\\|v/"
        },
        {
          "name": "keyword.operator.vector.causality.forward.omnicode",
          "match": "-->|->"
        },
        {
          "name": "keyword.operator.vector.causality.backward.omnicode",
          "match": "<--|<-"
        },
        {
          "name": "keyword.operator.vector.scale.up.omnicode",
          "match": "\\^--|--\\^|-\\^|↑"
        },
        {
          "name": "keyword.operator.vector.scale.down.omnicode",
          "match": "v--|--v|-v|↓"
        }
      ]
    },
    "being_relations": {
      "patterns": [
        {
          "name": "keyword.operator.relation.invariant_equivalence.omnicode",
          "match": "<=>"
        },
        {
          "name": "keyword.operator.relation.identity.omnicode",
          "match": "="
        },
        {
          "name": "keyword.operator.relation.distinction.omnicode",
          "match": "!="
        },
        {
          "name": "keyword.operator.relation.homomorphism.omnicode",
          "match": "~=|≈"
        },
        {
          "name": "keyword.operator.relation.comparison.omnicode",
          "match": "<=|>=|<|>"
        }
      ]
    },
    "connectives": {
      "patterns": [
        {
          "name": "keyword.operator.connective.caveat.omnicode",
          "match": "!"
        },
        {
          "name": "keyword.operator.connective.and.omnicode",
          "match": "::"
        },
        {
          "name": "keyword.operator.connective.relation.omnicode",
          "match": ":"
        },
        {
          "name": "keyword.operator.connective.or.omnicode",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.connective.not.omnicode",
          "match": "--"
        },
        {
          "name": "keyword.operator.connective.bound_pair.omnicode",
          "match": "&"
        },
        {
          "name": "keyword.operator.connective.percent.omnicode",
          "match": "%"
        },
        {
          "name": "keyword.operator.address.mmio.omnicode",
          "match": "::@|@"
        },
        {
          "name": "keyword.operator.range.omnicode",
          "match": "\\.\\."
        }
      ]
    },
    "boundaries": {
      "patterns": [
        {
          "name": "punctuation.definition.boundary.denotation.omnicode",
          "match": "\\[|\\]"
        },
        {
          "name": "punctuation.definition.boundary.invariant.omnicode",
          "match": "<|>"
        },
        {
          "name": "punctuation.definition.boundary.connotation.omnicode",
          "match": "\\{|\\}"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.omnicode",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.omnicode",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.language.register.omnicode",
          "match": "\\b(HEAD|HOME|SPOOL|IT|SELF|CALLER|OTHER|STATE|TURN|BOUND|FROM|INTO|DISCARD)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.block.omnicode",
          "match": "\\b(Module|Scroll|Opening|Body|Closing)\\b"
        },
        {
          "name": "keyword.other.declaration.omnicode",
          "match": "\\b(import|requires|preconditions|verify|commit_status|user_prompt|synthesized_reel|machine_utterance|repair_entry|failpoint_record|version|system|author|safety|semantics|timestamp|session_id|execution_duration_micros|cognitive_mode|Witness|Nature)\\b"
        },
        {
          "name": "keyword.control.loop.verb.omnicode",
          "match": "\\b(LOOP|WHEN|GOVERN|GUARD|TRAP|INSCRIBE|TRANSDUCE|PROJECT|SEQUENCE|ENCAPSULATE|LOCATE|BIND|ROUTE|SET_ASIDE|TRANSITION|CALCULATE|MEASURE|MODULATE|REPEAT|PLAY|PAUSE|REWIND|STOP)\\b"
        },
        {
          "name": "keyword.control.tape.omnicode",
          "match": "\\b(Tape|Track)\\b"
        },
        {
          "name": "keyword.other.clause.tape.omnicode",
          "match": "\\b(WHO|WHAT|WHEN|WHERE|WHY|HOW)\\b"
        },
        {
          "name": "entity.name.function.roll.omnicode",
          "match": "\\broll_\\d+\\b|\\bROLL\\b"
        },
        {
          "name": "keyword.operator.arithmetic.word.omnicode",
          "match": "\\b(plus|minus|times|divide|by|add|sub|mult|div)\\b"
        },
        {
          "name": "keyword.operator.infer.omnicode",
          "match": "\\?"
        }
      ]
    },
    "categories": {
      "patterns": [
        {
          "name": "entity.name.type.category.omnicode",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "instances": {
      "patterns": [
        {
          "name": "variable.other.instance.omnicode",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
