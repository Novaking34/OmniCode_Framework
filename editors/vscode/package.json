{
  "name": "omnicode-language",
  "displayName": "OmniCode Language Support",
  "description": "Syntax highlighting, boundary morphology, and 4-block architecture support for the OmniCode language",
  "version": "0.1.2",
  "publisher": "omnicode",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "omnicode",
        "aliases": [
          "OmniCode",
          "omnicode",
          "omni",
          "OmniCode Scroll",
          "scroll"
        ],
        "extensions": [
          ".omni",
          ".scroll"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "omnicode",
        "scopeName": "source.omnicode",
        "path": "./syntaxes/omnicode.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "omnicode",
        "path": "./snippets/omnicode.json"
      }
    ]
  }
}
