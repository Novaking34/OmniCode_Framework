{
    // =========================================================================
    // BLOCK 1: METADATA BLOCK
    // ( Workspace Identity, Column Geometry Rulers & Multi-Track Parity )
    // =========================================================================
    // @project       OmniCode Framework
    // @file          .vscode/settings.json
    // @id            root.ide.vscode_settings
    // @layer         Root Developer Workstation Configuration (Track 3 / 5)
    // @archetype     ide_config | operational
    // @version       0.1.3-dev
    // @interface_rev Rev 5
    // @date          2026-11-18
    // @author        CreativeWorkzStudio LLC / ProfessorSeanEX
    // @repository    https://github.com/Novaking34/OmniCode_Framework
    // @system        OmniCode Big House (Core + FaithNet + Tenebris-and-Lux)
    // @role          Enforces 80/100 Column Rulers, Multi-Lang & Preview Rules
    // @invariants    1. Universal 5-Block Lifecycle Protocol (Rev 5).
    //                2. Column Rulers: 80 = framing/comment/VGA bedrock (teal);
    //                   100 = hard code-line ceiling (coral).
    //                3. Zero hardcoded user-home paths (${workspaceFolder}).
    //                4. Strict link/fragment validation for Markdown docs.
    // =========================================================================

    // =========================================================================
    // BLOCK 2: OPENING BLOCK
    // ( File Associations, Text Encodings & Line-Ending Determinism )
    // =========================================================================
    "files.associations": {
        "*.omni": "omnicode",
        "*.scroll": "omnicode",
        "*.tape": "omnicode",
        "*.adoc": "asciidoc",
        "*.asciidoc": "asciidoc"
    },
    "files.encoding": "utf8",
    "files.eol": "\n",
    "workbench.layoutControl.enabled": true,

    // =========================================================================
    // BLOCK 3: BODY BLOCK
    // ( 80/100 Column Rulers, Multi-Track Language Settings & Doc Previews )
    // =========================================================================
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.renderWhitespace": "selection",
    // Column Geometry:
    //   80  -> Framing bedrock (5-Block borders, headers, comments, VGA 80x25)
    //   100 -> Hard code ceiling (dense expressions; exempt unbreakable paths)
    "editor.rulers": [
        { "column": 80, "color": "#4ec9b066" },
        { "column": 100, "color": "#f4474788" }
    ],
    "editor.minimap.enabled": false,
    "editor.wordWrap": "off",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.lineNumbers": "on",
    "editor.folding": true,

    // --- Track-Specific & Submodule Language Profiles ---
    "[omnicode]": {
        "editor.rulers": [
            { "column": 80, "color": "#4ec9b066" },
            { "column": 100, "color": "#f4474788" }
        ],
        "editor.wordWrap": "off",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.hover.enabled": "on",
        "editor.hover.delay": 300,
        "editor.quickSuggestions": {
            "other": "on",
            "comments": "off",
            "strings": "on"
        }
    },
    "[rust]": {
        "editor.rulers": [
            { "column": 80, "color": "#4ec9b066" },
            { "column": 100, "color": "#f4474788" }
        ],
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.semanticHighlighting.enabled": true
    },
    "[c]": {
        "editor.rulers": [
            { "column": 80, "color": "#4ec9b066" },
            { "column": 100, "color": "#f4474788" }
        ],
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[cpp]": {
        "editor.rulers": [
            { "column": 80, "color": "#4ec9b066" },
            { "column": 100, "color": "#f4474788" }
        ],
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[go]": {
        "editor.rulers": [
            { "column": 80, "color": "#4ec9b066" },
            { "column": 100, "color": "#f4474788" }
        ],
        "editor.insertSpaces": false,
        "editor.tabSize": 4
    },
    "[shellscript]": {
        "editor.rulers": [
            { "column": 80, "color": "#4ec9b066" },
            { "column": 100, "color": "#f4474788" }
        ],
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[python]": {
        "editor.rulers": [
            { "column": 80, "color": "#4ec9b066" },
            { "column": 100, "color": "#f4474788" }
        ],
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[toml]": {
        "editor.rulers": [
            { "column": 80, "color": "#4ec9b066" },
            { "column": 100, "color": "#f4474788" }
        ],
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[makefile]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 4
    },
    "[markdown]": {
        "editor.rulers": [
            { "column": 80, "color": "#4ec9b066" },
            { "column": 100, "color": "#f4474788" }
        ],
        "editor.wordWrap": "on",
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false,
        "editor.quickSuggestions": {
            "other": "on",
            "comments": "off",
            "strings": "on"
        }
    },
    "[asciidoc]": {
        "editor.rulers": [
            { "column": 80, "color": "#4ec9b066" },
            { "column": 100, "color": "#f4474788" }
        ],
        "editor.wordWrap": "on",
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.quickSuggestions": {
            "other": "on",
            "comments": "off",
            "strings": "on"
        }
    },

    // --- AsciiDoc Previewer & Diagram Rendering Support ---
    "asciidoc.preview.defaultStyle": "asciidoctor",
    "asciidoc.preview.openLinksToAsciidocFiles": "inPreview",
    "asciidoc.preview.scrollEditorWithPreview": true,
    "asciidoc.preview.scrollPreviewWithEditor": true,
    "asciidoc.extensions.enableKroki": true,

    // --- Markdown Rendering, Typography, KaTeX Math & Link Validation ---
    "markdown.math.enabled": true,
    "markdown.preview.breaks": true,
    "markdown.preview.linkify": true,
    "markdown.preview.typographer": true,
    "markdown.preview.doubleClickToSwitchToEditor": true,
    "markdown.preview.scrollEditorWithPreview": true,
    "markdown.preview.scrollPreviewWithEditor": true,
    "markdown.preview.openMarkdownLinks": "inPreview",
    "markdown.editor.drop.enabled": "smart",
    "markdown.editor.pasteUrlAsFormattedLink.enabled": "smart",
    "markdown.suggest.paths.enabled": true,
    "markdown.validate.enabled": true,
    "markdown.validate.fileLinks.enabled": "warning",
    "markdown.validate.fragmentLinks.enabled": "warning",
    "markdown.validate.referenceLinks.enabled": "warning",

    // --- Mermaid Diagram Vector Rendering Support ---
    "markdown-mermaid.darkModeTheme": "dark",
    "markdown-mermaid.theme": "default",

    // --- Portable Submodule CMake Binding (Zero Hardcoded Home Paths) ---
    "cmake.sourceDirectory": "${workspaceFolder}/Tenebris-and-Lux",

    // =========================================================================
    // BLOCK 4: AUDIT PROCEDURES BLOCK
    // ( Workspace Watcher Isolation, Search Hygiene & Trailing Whitespace )
    // =========================================================================
    // Verify valid JSONC & zero hardcoded user paths in active settings:
    //   grep -v '//' .vscode/settings.json | grep -n '/home/' || echo "PASS"
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/target/**": true,
        "**/build/**": true,
        "**/node_modules/**": true,
        "**/*.weights": true,
        "**/*.bin": true
    },
    "search.exclude": {
        "**/target": true,
        "**/build": true,
        "**/node_modules": true,
        "**/*.weights": true,
        "**/*.bin": true
    }

    // =========================================================================
    // BLOCK 5: CLOSING BLOCK
    // ( Workstation Invariants & Status Seal )
    // =========================================================================
    // - 80-column framing target (teal) + 100-column code ceiling (coral).
    // - Portable ${workspaceFolder} submodule binding; zero machine lock-in.
    // Status: VSCODE_SETTINGS_SEALED (+1:PROCEED)
    // =========================================================================
}
