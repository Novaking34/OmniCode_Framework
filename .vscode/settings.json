{
    // ==============================================================================
    // BLOCK 1: METADATA BLOCK
    // ( Workspace Identity, Invariant Architectural Scope & Implicit Environment Physics )
    // ==============================================================================
    // Workspace:     OmniCode Multi-Track Cognitive Engine & Standard Library
    // Organization:  CreativeWorkzStudio LLC
    // Repository:    https://github.com/Novaking34/OmniCode_Framework
    // Purpose:       This file constitutes the primordial implicit boundary container
    //                for the OmniCode workspace. It governs editor mechanics, multi-track
    //                language parity (OmniCode, Rust, C, Makefile), whitespace hygiene,
    //                and search/watcher isolation to guarantee zero-friction determinism.
    // Invariant:     Form precedes fullness. Establish the boundary before populating state.
    // ==============================================================================

    // ==============================================================================
    // BLOCK 2: OPENING BLOCK
    // ( File Associations, Text Encodings & System Bootstrap )
    // ==============================================================================
    "files.associations": {
        "*.omni": "omnicode",
        "*.scroll": "omnicode",
        "*.tape": "omnicode"
    },
    "files.encoding": "utf8",
    "files.eol": "\n",
    "workbench.layoutControl.enabled": true,

    // ==============================================================================
    // BLOCK 3: BODY BLOCK
    // ( Core Editor Mechanics & Multi-Language Track Parity )
    // ==============================================================================
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.renderWhitespace": "selection",
    "editor.rulers": [80],
    "editor.minimap.enabled": false,
    "editor.wordWrap": "off",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.lineNumbers": "on",
    "editor.folding": true,

    // --- Track-Specific Language Blocks ---
    "[omnicode]": {
        "editor.rulers": [80],
        "editor.wordWrap": "off",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[rust]": {
        "editor.rulers": [80],
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.semanticHighlighting.enabled": true
    },
    "[c]": {
        "editor.rulers": [80],
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[makefile]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 4
    },
    "[markdown]": {
        "editor.rulers": [80, 100],
        "editor.wordWrap": "on",
        "editor.quickSuggestions": {
            "comments": "off",
            "strings": "off",
            "other": "off"
        }
    },

    // ==============================================================================
    // BLOCK 4: CLOSING BLOCK
    // ( Workspace Hygiene, Exclusions, Performance Isolation & Invariant Seals )
    // ==============================================================================
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/target/**": true,
        "**/node_modules/**": true,
        "**/*.weights": true,
        "**/*.bin": true
    },
    "search.exclude": {
        "**/target": true,
        "**/node_modules": true,
        "**/*.weights": true,
        "**/*.bin": true
    }
}
