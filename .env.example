# ==============================================================================
# BLOCK 1: METADATA BLOCK
# ( CreativeWorkzStudio LLC - OmniCode Runtime Configuration Template )
# ==============================================================================
# Platform:     OmniCode Multi-Track Cognitive Engine, Bare-Metal OS & Studio
# Organization: CreativeWorkzStudio LLC
# Repository:   https://github.com/Novaking34/OmniCode_Framework
# Purpose:      Environment specification template for local development, web server,
#               cloud sync, bare-metal QEMU virtualization, and multi-track telemetry.
# Usage:        Copy this template to `.env` and populate environment-specific secrets:
#                 cp .env.example .env
# Invariant:    Form precedes fullness. Establish the boundary before populating state.
# ==============================================================================

# ==============================================================================
# BLOCK 2: OPENING BLOCK - RUNTIME & HOST ENVIRONMENT
# ==============================================================================
# Execution Environment ("development" | "staging" | "production")
ENVIRONMENT="production"
ORGANIZATION="CreativeWorkzStudio LLC"

# Host IP and Port for OmniCode HTTP Web Studio HUD and REST Gateway
OMNICODE_HOST="0.0.0.0"
WEB_PORT="8080"

# Offline Mode: Enforces 100% local operation via Biblical Lexicon & Manifest
OMNICODE_OFFLINE="1"

# Telemetry Logging Level ("trace" | "debug" | "info" | "warn" | "error")
RUST_LOG="info"

# Multi-Track Workspace Directories & Storage Anchor Paths
OMNICODE_STORAGE_DIR="<TRACK 4> : {Variable Storage & Episodic Memory}/storage"
OMNICODE_SCROLLS_DIR="<TRACK 4> : {Variable Storage & Episodic Memory}/storage/scrolls"
OMNICODE_LEXICON_DIR="<TRACK 2> : {OmniCode Language & Standard Library}/lexicon"

# ==============================================================================
# BLOCK 3: BODY BLOCK - NETWORK ENDPOINTS, CLOUD & BARE-METAL INFRASTRUCTURE
# ==============================================================================
# Public Endpoint & Dynamic DNS (CreativeWorkzStudio LLC)
PUBLIC_DOMAIN="omnicodestudio.duckdns.org"
PUBLIC_WAN_IP="71.11.99.168"
PUBLIC_API_URL="http://omnicodestudio.duckdns.org:8080"
DUCKDNS_DOMAIN="omnicodestudio"

# Oracle Cloud Compute Infrastructure (24/7 Remote Host)
ORACLE_VM_HOST="147.224.147.30"
ORACLE_VM_USER="ubuntu"
ORACLE_SSH_KEY="/home/professorseanex/.ssh/oracle_key.pem"
ORACLE_REMOTE_DIR="/home/ubuntu/OmniCode"

# Cloudflare Zero Trust Edge Tunnel
CLOUDFLARE_TUNNEL_NAME="ygo-server-tunnel"
CLOUDFLARE_TUNNEL_ID="c346aa27-b4c1-41ba-815c-f66b2b84243b"
CLOUDFLARE_ACCOUNT_ID="4f03932a24c29d06b5391a27e7d956a9"
CLOUDFLARE_TUNNEL_TOKEN="your_cloudflare_tunnel_token_here"

# Bare-Metal QEMU Hardware Emulation Ports
QEMU_GDB_PORT="1234"
QEMU_VNC_PORT="5900"

