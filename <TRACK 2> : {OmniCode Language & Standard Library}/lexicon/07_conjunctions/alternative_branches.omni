# ==============================================================================
# BLOCK 1: METADATA BLOCK
# ( Ontological Conjunctions: Alternative Disjunctions & Multi-Path Valves )
# ==============================================================================
# ARCHITECTURAL TOPOLOGY:
#   Defines disjunctive valves, alternative pathways, and branching:
#   - | : Alternative branch conjunction (disjunctive valve, fallback path).
# ==============================================================================

Module < Lexicon.Conjunctions.AlternativeBranches >
    ( Disjunctive alternative branches and valves )
{
    version: < "1.0.0" >,
    system: < OmniCode.Lexicon >,
    semantics: < AlternativeBranches :: DisjunctiveValves ::
                 MultiPathBifurcations >
}

# 1. Disjunctive Alternative Conjunction: < OR >
Or < InvariantConjunction > ( Disjunctive Alternative Branch & Valve: | ) {
    grammar_primary: < "Conjunction" >,
    grammar_secondary: < "Preposition" >,
    symbol: < "|" >,
    abstract_form: < "+Or" >,
    concrete_form: < "Or-" >,
    machine_effect: < "alternative_disjunction_branch" >
}

# ==============================================================================
# BLOCK 2: OPENING BLOCK
# ==============================================================================
Opening {
    requires: [
        Or : InvariantConjunction
    ],
    preconditions: [ +1 ]
}

# ==============================================================================
# BLOCK 3: BODY BLOCK
# ==============================================================================
Body [
    # Verify disjunctive alternative branching
    alternative_verification [
        Equilibrium_Branch [ Condition_Zero --> PROCEED |
                             Condition_Trap --> ROLLBACK ] ::
        Fallback_Branch    [ Target_Busy --> AWAIT |
                             Target_Ready --> PROCEED ]
    ] ( Disjunctive alternative branching verified )
]

# ==============================================================================
# BLOCK 4: CLOSING BLOCK
# ==============================================================================
Closing {
    verify: [
        alternative_verification = yes
    ],
    commit_status [ PROCEED- ]
        ( Alternative branch conjunctions verified and sealed )
}
